{
  "name": "letlytics-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "image:generate": "node --import tsx scripts/generate-social-image.tsx",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
